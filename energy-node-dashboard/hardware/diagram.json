{
  "version": 1,
  "author": "Energy-Aware Predictive Maintenance Node",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-c3-devkitm-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-mpu6050", "id": "mpu1", "top": -140, "left": 160, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_current", "top": 150, "left": -180, "attrs": { "label": "ACS712 Current Load (A)" } },
    { "type": "wokwi-potentiometer", "id": "pot_supercap", "top": 280, "left": -180, "attrs": { "label": "0.5F Supercap Voltage (V)" } },
    { "type": "wokwi-led", "id": "status_led", "top": -80, "left": -80, "attrs": { "color": "green", "label": "TX Pulse" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "mpu1:GND", "black", [ "v0" ] ],
    [ "esp:3V3.1", "mpu1:VCC", "red", [ "v0" ] ],
    [ "esp:8", "mpu1:SDA", "blue", [ "v0" ] ],
    [ "esp:9", "mpu1:SCL", "yellow", [ "v0" ] ],
    [ "esp:GND.2", "pot_current:GND", "black", [ "v0" ] ],
    [ "esp:3V3.2", "pot_current:VCC", "red", [ "v0" ] ],
    [ "esp:0", "pot_current:SIG", "green", [ "v0" ] ],
    [ "esp:GND.3", "pot_supercap:GND", "black", [ "v0" ] ],
    [ "esp:3V3.3", "pot_supercap:VCC", "red", [ "v0" ] ],
    [ "esp:1", "pot_supercap:SIG", "orange", [ "v0" ] ],
    [ "esp:GND.4", "status_led:C", "black", [ "v0" ] ],
    [ "esp:2", "status_led:A", "green", [ "v0" ] ]
  ],
  "surroundings": {}
}
